{
  "version": 8,
  "name": "Reverse Earth — Natural Earth",
  "metadata": {
    "description": "A warm, south-up Natural Earth basemap with a compact place-label hierarchy.",
    "south_up": true
  },
  "glyphs": "fonts/{fontstack}/{range}.pbf",
  "sources": {
    "world": {
      "type": "vector",
      "url": "pmtiles://data/world.pmtiles",
      "minzoom": 0,
      "maxzoom": 6,
      "attribution": "<a href=\"https://www.naturalearthdata.com/\" target=\"_blank\" rel=\"noopener\">Natural Earth</a> (public domain)"
    }
  },
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#a9cbe0"
      }
    },
    {
      "id": "land",
      "type": "fill",
      "source": "world",
      "source-layer": "land",
      "paint": {
        "fill-color": "#f2eee5",
        "fill-outline-color": "#d6d0c4"
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "world",
      "source-layer": "water",
      "paint": {
        "fill-color": "#9dc7e1",
        "fill-outline-color": "#89b6d3"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "world",
      "source-layer": "waterway",
      "minzoom": 3,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8fbcd8",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          3,
          0.4,
          6,
          1.1,
          10,
          2.2,
          14,
          3.6
        ]
      }
    },
    {
      "id": "road-major",
      "type": "line",
      "source": "world",
      "source-layer": "road",
      "filter": ["==", ["get", "class"], "major"],
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e0bd92",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.55,
          6,
          0.95,
          10,
          2.6,
          14,
          4.6
        ],
        "line-opacity": 0.9
      }
    },
    {
      "id": "road-secondary",
      "type": "line",
      "source": "world",
      "source-layer": "road",
      "filter": ["==", ["get", "class"], "secondary"],
      "minzoom": 6,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#e7cdaa",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          0.5,
          10,
          1.5,
          14,
          3
        ],
        "line-opacity": 0.85
      }
    },
    {
      "id": "railway",
      "type": "line",
      "source": "world",
      "source-layer": "railway",
      "minzoom": 5,
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#8f887d",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.4,
          6,
          0.65,
          10,
          1.1,
          14,
          1.6
        ],
        "line-dasharray": [3, 2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "boundary-admin1",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": ["==", ["get", "kind"], "admin1"],
      "minzoom": 5,
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#c8bcab",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          0.4,
          6,
          0.6,
          10,
          0.9,
          14,
          1.2
        ],
        "line-opacity": 0.6
      }
    },
    {
      "id": "boundary",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "kind"], "country"],
        ["!=", ["get", "disputed"], true]
      ],
      "layout": {
        "line-cap": "round",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b9a68f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          0.5,
          3,
          0.8,
          6,
          1.3,
          10,
          1.8
        ],
        "line-opacity": 0.75
      }
    },
    {
      "id": "boundary-disputed",
      "type": "line",
      "source": "world",
      "source-layer": "boundary",
      "filter": [
        "all",
        ["==", ["get", "kind"], "country"],
        ["==", ["get", "disputed"], true]
      ],
      "layout": {
        "line-cap": "butt",
        "line-join": "round"
      },
      "paint": {
        "line-color": "#b9a68f",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          1,
          6,
          1.6
        ],
        "line-dasharray": [2, 2],
        "line-opacity": 0.7
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "country"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["KlokanTech Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          0,
          10,
          2,
          12,
          4,
          14,
          6,
          15
        ],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12,
        "text-max-width": 8,
        "text-padding": 4
      },
      "paint": {
        "text-color": "#8b8175",
        "text-halo-color": "rgba(242, 238, 229, 0.9)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-capital-dot",
      "type": "circle",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "capital"],
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          1,
          2.2,
          6,
          3.2
        ],
        "circle-color": "#a94f31",
        "circle-stroke-color": "#fffaf4",
        "circle-stroke-width": 1
      }
    },
    {
      "id": "place-capital",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "capital"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["KlokanTech Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          1,
          10,
          4,
          12,
          6,
          13
        ],
        "text-anchor": "top",
        "text-offset": [0, 0.7],
        "text-max-width": 9,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#3d3831",
        "text-halo-color": "rgba(255, 253, 249, 0.92)",
        "text-halo-width": 1.4
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "city"],
      "minzoom": 2,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["KlokanTech Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          9,
          4,
          10.5,
          6,
          12
        ],
        "text-anchor": "top",
        "text-offset": [0, 0.55],
        "text-max-width": 9,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#514a42",
        "text-halo-color": "rgba(255, 253, 249, 0.9)",
        "text-halo-width": 1.2
      }
    },
    {
      "id": "place-city-dot",
      "type": "circle",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "city"],
      "minzoom": 2,
      "paint": {
        "circle-radius": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          1.5,
          6,
          2.4
        ],
        "circle-color": "#7c7266"
      }
    },
    {
      "id": "place-town",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "town"],
      "minzoom": 5,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["KlokanTech Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          9,
          8,
          10.5,
          12,
          12
        ],
        "text-anchor": "top",
        "text-offset": [0, 0.5],
        "text-max-width": 8,
        "text-padding": 2
      },
      "paint": {
        "text-color": "#5d554b",
        "text-halo-color": "rgba(255, 253, 249, 0.88)",
        "text-halo-width": 1.1
      }
    },
    {
      "id": "place-region",
      "type": "symbol",
      "source": "world",
      "source-layer": "place",
      "filter": ["==", ["get", "kind"], "region"],
      "minzoom": 6,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["KlokanTech Noto Sans Italic"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          8.5,
          9,
          10.5,
          13,
          12
        ],
        "text-letter-spacing": 0.04,
        "text-max-width": 8,
        "text-padding": 3
      },
      "paint": {
        "text-color": "#7b7163",
        "text-halo-color": "rgba(242, 238, 229, 0.9)",
        "text-halo-width": 1.1,
        "text-opacity": 0.9
      }
    }
  ]
}
